{
  "name": "weaving-site",
  "private": true,
  "version": "0.216.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('./package.json','utf8'));fs.writeFileSync('dist/version.json',JSON.stringify({version:p.version,built_at:new Date().toISOString()}))\"",
    "preview": "vite preview",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.101.2",
    "@types/dompurify": "^3.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0"
  },

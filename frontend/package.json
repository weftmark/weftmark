{
  "name": "weaving-site",
  "private": true,
  "version": "0.216.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('./package.json','utf8'));fs.writeFileSync('dist/version.json',JSON.stringify({version:p.version,built_at:new Date().toISOString()}))\"",
    "preview": "vite preview",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@sentry/react": "^11.7.0",
    "@tanstack/react-query": "^5.104.2",
    "@types/dompurify": "^3.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "i18next": "^26.4.5",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"

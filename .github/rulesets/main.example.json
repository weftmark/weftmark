{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "dismissal_restriction": {
          "enabled": false,
          "allowed_actors": []
        },
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          {
            "context": "Source branch must be dev or hotfix/*",
            "integration_id": 15368
          },
          {
            "context": "No file writes in main CI",
            "integration_id": 15368
          },
          {
            "context": "Backend lint (ruff)",
            "integration_id": 15368
          },
          {
            "context": "Frontend lint (eslint)",
            "integration_id": 15368
          },
          {
            "context": "Frontend type check (tsc)",
            "integration_id": 15368
          },
          {
            "context": "Dependency audit — backend (pip-audit)",
            "integration_id": 15368
          },
          {
            "context": "Dependency audit — frontend (npm audit)",
            "integration_id": 15368
          },
          {
            "context": "Docker build — backend",
            "integration_id": 15368
          },
          {
            "context": "Docker build — frontend",
            "integration_id": 15368
          },
          {
            "context": "Docker build — error pages",
            "integration_id": 15368
          }
        ]
      }
    }
  ],
  "_notes": [
    "TODO: add 'required_deployments' rule once deployment environments are configured in GitHub Settings → Environments"
  ],
  "bypass_actors": [
    {
      "actor_id": null,
      "actor_type": "OrganizationAdmin",
      "bypass_mode": "pull_request"
    },
    {
      "actor_id": YOUR_WEFTMARK_BOT_INSTALLATION_ID,
      "actor_type": "Integration",
      "bypass_mode": "always"
    }
  ]
}
